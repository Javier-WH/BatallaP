{
  "name": "batalla-project",
  "version": "1.0.5",
  "description": "School Management System - Backend + Frontend",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:sqlite": "concurrently \"npm run dev:sqlite:backend\" \"npm run dev:frontend\"",
    "dev:sqlite:backend": "cd backend && npm run dev:sqlite",
    "build": "npm run build:backend && npm run build:frontend",
    "build:prod": "node build-production.js",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "deploy:branch": "node deploy-branch.js",
    "deploy": "npm run build:prod && npm run deploy:branch"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
